---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { withBase } from '~/utils'
---

<LayoutDefault>
  <section class="nf">
    <p class="nf-code">404</p>
    <h1 class="post-title"><a class="not-prose">페이지를 찾을 수 없습니다</a></h1>
    <p>주소가 바뀌었거나 아직 공개되지 않은 글일 수 있습니다.</p>
    <p class="nf-links">
      <a href={withBase('/')}>글 목록으로</a>
      <a href={withBase('/search/')}>검색하기</a>
    </p>
  </section>
</LayoutDefault>

<style is:global>
  .nf { padding-top: 1.5rem; }
  .nf-code { font-family: var(--uno-fonts-header, serif); font-size: 5.5rem; font-weight: 900; line-height: 1; margin: 0 0 .6rem; opacity: .22; }
  .nf-links { display: flex; gap: 1.2rem; margin-top: 1.2rem; }
</style>
