---
import type { Post } from '~/types'
import { formatDate, getReadingMinutes, withBase } from '~/utils'
import PostCategory from './PostCategory.astro'

interface Props {
  post: Post
  detail?: boolean
}

const { post, detail = false } = Astro.props
const { translate: t } = Astro.locals

const categoryList = post.data.categories ?? []
const tagList = post.data.tags ?? []
const minutes = getReadingMinutes(post.body)
---

<header flex="~ col gap-2">
  <h1 class="post-title" data-pagefind-meta="title">
    <a class="not-prose" href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a>
  </h1>
  <div class="text-3.5" data-pagefind-ignore>
    <span>{t(post.data.modDate ? 'updated_at' : 'posted_at')}</span>
    <time>{formatDate(post.data.modDate ?? post.data.pubDate)}</time>
    {categoryList.map((category) => <PostCategory category={category} />)}
    <span class="post-read">· 읽는 시간 약 {minutes}분</span>
  </div>
  {detail && tagList.length > 0 && (
    <div class="post-tags" data-pagefind-ignore>
      {tagList.map((tag) => <a class="post-tag not-prose" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}
    </div>
  )}
</header>
